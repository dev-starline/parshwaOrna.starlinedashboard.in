@model IEnumerable<SL_Bullion.Models.DeleteOrder>
@{
	ViewData["Title"] = "DeleteOrder";
	Layout = "~/Views/Shared/_Layout.cshtml";
	string fromDateQuery = Context.Request.Query["fromDate"];
	string toDateQuery = Context.Request.Query["toDate"];
	string loginIdQuery = Context.Request.Query["loginId"];
	string defaultDate = DateTime.Today.ToString("yyyy-MM-dd");
	string fromDateValue = string.IsNullOrEmpty(fromDateQuery) ? defaultDate : fromDateQuery;
	string toDateValue = string.IsNullOrEmpty(toDateQuery) ? defaultDate : toDateQuery;
}

<div class="tab-bottom-cvr w-100 d-inline-block py-2">
	<div class="container-fluid">
		<div class="row">
			<form asp-action="search" method="GET" class="col-lg-7 col-md-12 col-sm-12">
				<div class="top-cover">
					<div class="form-inline my-2 my-lg-0 justify-content-end">
						<input type="hidden" name="tradeFilter" value="@Context.Request.Query["tradeFilter"]" />
						@* <div class="datepicket order-sm-1">
							<label for="datepicker" class="d-inline-block">Login Id :</label>
							<input name="loginId" type="text">
						</div> *@
						<div class="datepicket order-sm-1">
							<label for="loginId" class="d-inline-block">OrderNo or LoginId :</label>
							<input name="loginId" type="text" id="loginId" value="@loginIdQuery">
						</div>
						@* <div class="datepicket">
                            <label for="datepicker" class="d-inline-block">From :</label>
                            <input name="fromDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="d-inline-block" type="date" id="fromDate">
						</div>
						<div class="datepicket">
                            <label for="datepicker" class="d-inline-block">To :</label>
                            <input name="toDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="d-inline-block" type="date" id="toDate">
						</div> *@
						<div class="datepicket">
							<label for="fromDate" class="d-inline-block">From :</label>
							<input name="fromDate" value="@fromDateValue" class="d-inline-block" type="date" id="fromDate">
						</div>
						<div class="datepicket">
							<label for="toDate" class="d-inline-block">To :</label>
							<input name="toDate" value="@toDateValue" class="d-inline-block" type="date" id="toDate">
						</div>
						<div class="submit-btn order-sm-1">
							<button class="btn common-bg color-white sm-font">Submit</button>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
<div class="container-fluid">
	<div class="table-cover">
		<div class="row ml-0 mr-0">
			<div class="col-lg-4 col-md-0 col-sm-12"></div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<h4 class="text-center mt-1 mb-2">Delete Order</h4>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="top-cover">
					<div class="form-inline my-2 my-lg-0 justify-content-end">
						<a class="btn common-bg color-white sm-font" href="@Url.Action("List", new { tradeFilter = "all" })">All Order</a>
						<a class="btn common-bg color-white sm-font ml-2" href="@Url.Action("List", new { tradeFilter = "buy" })">Buy Order</a>
						<a class="btn common-bg color-white sm-font ml-2" href="@Url.Action("List", new { tradeFilter = "sell" })">Sell Order</a>
						<button class="btn common-bg color-white sm-font ml-2">Export to Excel</button>
						<button onclick="selectOrder('close')" class="btn common-bg color-white sm-font ml-2">CloseAll</button>
						<button onclick="selectOrder('delete')" class="btn common-bg color-white sm-font ml-2">DeleteAll</button>
					</div>
				</div>
			</div>
		</div>
		<div class="table-wrapper vg">
			<table>
				<thead class="scrolltb">
					<tr>
						<th class="common-bg thead-font wtwo">OrderNo</th>
						<th class="common-bg thead-font wtwo">LoginId</th>
						<th class="common-bg thead-font wfive">Name/Firm</th>
						<th class="common-bg thead-font wtwo">Mobile</th>
						<th class="common-bg thead-font wfive">Symbol</th>
						<th class="common-bg thead-font wone">RateType</th>
						<th class="common-bg thead-font wtwo">TradeType</th>
						<th class="common-bg thead-font wtwo">Quantity</th>
						<th class="common-bg thead-font wtwo">Price</th>
						<th class="common-bg thead-font wfive">Total</th>
						<th class="common-bg thead-font wtwo">From</th>
						<th class="common-bg thead-font wfive">DeleteTime</th>
						<th class="common-bg thead-font wfive">Time</th>
						<th class="common-bg thead-font wfive">UpdateTime</th>
						<th class="common-bg thead-font wfive">IP</th>
						<th class="common-bg thead-font wten">Comment</th>
						<th class="common-bg thead-font wtwo">Open</th>
					</tr>
				</thead>
				<tbody class="executeOrder">
					@foreach (var item in Model)
					{
						<tr>
							<td class="wtwo"><div class="content"><p>@item.dealNo</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.loginId</p></div></td>
							<td class="wfive"><div class="content"><p>@item.firm</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.mobile</p></div></td>
							<td class="wfive"><div class="content"><p>@item.symbolName</p></div></td>
							<td class="wone"><div class="content"><p>@(item.rateType == "mcx" ? "exchange" : item.rateType)</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.tradeTypeView</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.volume</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.rate</p></div></td>
							<td class="wfive"><div class="content"><p>@item.total</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.deviceType</p></div></td>
							<td class="wfive"><div class="content"><p>@item.deleteTime</p></div></td>
							<td class="wfive"><div class="content"><p>@item.orderTime</p></div></td>
							<td class="wfive"><div class="content"><p>@item.editorderTime</p></div></td>
							<td class="wfive"><div class="content"><p>@item.ip</p></div></td>
							<td class="wten"><div class="content"><p>@item.comment</p></div></td>
							<td class="wtwo"><div class="content"><form asp-action="Delete" asp-route-id="@item.id" asp-route-tradeFilter="@Context.Request.Query["tradeFilter"]"><button onclick="return confirmDelete('open')"><i class="fa fa-external-link text-success" aria-hidden="true"></i></button></form></div></td>
						</tr>
					}
				</tbody>
			</table>
		</div>

	</div>
</div>
<script src="~/adminjs/order.js"></script>
