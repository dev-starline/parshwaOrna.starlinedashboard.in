@model IEnumerable<SL_Bullion.Models.CloseOrder>
@{
	ViewData["Title"] = "CloseOrder";
	Layout = "~/Views/Shared/_Layout.cshtml";
	string fromDateQuery = Context.Request.Query["fromDate"];
	string toDateQuery = Context.Request.Query["toDate"];
	string loginIdQuery = Context.Request.Query["loginId"];
	string sourceFilterQuery = Context.Request.Query["sourceFilter"];
	string defaultDate = DateTime.Today.ToString("yyyy-MM-dd");
	string fromDateValue = string.IsNullOrEmpty(fromDateQuery) ? defaultDate : fromDateQuery;
	string toDateValue = string.IsNullOrEmpty(toDateQuery) ? defaultDate : toDateQuery;
}

<div class="tab-bottom-cvr w-100 d-inline-block py-2">
	<div class="container-fluid">
		<div class="row">
			<form asp-action="search" method="GET" class="col-lg-7 col-md-12 col-sm-12">
				<div class="top-cover">
					<div class="form-inline my-2 my-lg-0 justify-content-end">
						<input type="hidden" name="tradeFilter" value="@Context.Request.Query["tradeFilter"]" />
						<input type="hidden" name="sourceFilter" value="@sourceFilterQuery" />
						<div class="datepicket order-sm-1">
							<label for="loginId" class="d-inline-block">OrderNo or LoginId :</label>
							<input name="loginId" type="text" id="loginId" value="@loginIdQuery">
						</div>
						<div class="datepicket">
							<label for="fromDate" class="d-inline-block">From :</label>
							<input name="fromDate" value="@fromDateValue" class="d-inline-block" type="date" id="fromDate">
						</div>
						<div class="datepicket">
							<label for="toDate" class="d-inline-block">To :</label>
							<input name="toDate" value="@toDateValue" class="d-inline-block" type="date" id="toDate">
						</div>
						<div class="submit-btn order-sm-1">
							<button formaction="@Url.Action("search")" class="btn common-bg color-white sm-font">Submit</button>
							<button formaction="@Url.Action("ExportToExcel")" class="btn common-bg color-white sm-font ml-2" type="submit">Export to Excel</button>
						</div>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
<div class="container-fluid">
	<div class="table-cover">
		<div class="row ml-0 mr-0">
			<div class="col-lg-4 col-md-0 col-sm-12">
				<div class="ord-drp">
				<select class="order-filter-select mr-2" onchange="window.location.href=this.value">
					@if (string.IsNullOrWhiteSpace(Context.Request.Query["tradeFilter"]) || Context.Request.Query["tradeFilter"].ToString() == "all")
					{
						<option value="@Url.Action("List", new { tradeFilter = "all", sourceFilter = sourceFilterQuery })" selected>All</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = "all", sourceFilter = sourceFilterQuery })">All</option>
					}
					@if (Context.Request.Query["tradeFilter"].ToString() == "buy")
					{
						<option value="@Url.Action("List", new { tradeFilter = "buy", sourceFilter = sourceFilterQuery })" selected>Buy</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = "buy", sourceFilter = sourceFilterQuery })">Buy</option>
					}
					@if (Context.Request.Query["tradeFilter"].ToString() == "sell")
					{
						<option value="@Url.Action("List", new { tradeFilter = "sell", sourceFilter = sourceFilterQuery })" selected>Sell</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = "sell", sourceFilter = sourceFilterQuery })">Sell</option>
					}
				</select>
				<select class="order-filter-select mr-2" onchange="window.location.href=this.value">
					@if (string.IsNullOrWhiteSpace(sourceFilterQuery) || sourceFilterQuery == "all")
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "all" })" selected>All</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "all" })">All</option>
					}
					@if (sourceFilterQuery == "gold")
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "gold" })" selected>Gold</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "gold" })">Gold</option>
					}
					@if (sourceFilterQuery == "silver")
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "silver" })" selected>Silver</option>
					}
					else
					{
						<option value="@Url.Action("List", new { tradeFilter = Context.Request.Query["tradeFilter"].ToString(), sourceFilter = "silver" })">Silver</option>
					}
				</select>
				</div>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<h4 class="text-center mt-1 mb-2">Close Order</h4>
			</div>
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="top-cover">
					<div class="form-inline my-2 my-lg-0 justify-content-end">
					
						<button onclick="selectOrder('close')" class="btn common-bg color-white sm-font ml-2">CloseAll</button>
						<button onclick="selectOrder('delete')" class="btn common-bg color-white sm-font ml-2">DeleteAll</button>
					</div>
				</div>
			</div>
		</div>
		<div class="table-wrapper vg">
			<table>
				<thead>
					<tr>
						<th class="common-bg thead-font wtwo">OrderNo</th>
						<th class="common-bg thead-font wtwo">LoginId</th>
						<th class="common-bg thead-font wfive">Name/Firm</th>
						<th class="common-bg thead-font wtwo">Mobile</th>
						<th class="common-bg thead-font wfive">Symbol</th>
						<th class="common-bg thead-font wone">RateType</th>
						<th class="common-bg thead-font wtwo">TradeType</th>
						<th class="common-bg thead-font wtwo">OpenQuantity</th>
						<th class="common-bg thead-font wtwo">Quantity</th>
						<th class="common-bg thead-font wtwo">OpenPrice</th>
						<th class="common-bg thead-font wtwo">Price</th>
						<th class="common-bg thead-font wfive">Total</th>
						<th class="common-bg thead-font wtwo">From</th>
						<th class="common-bg thead-font wten">CloseTime</th>
						<th class="common-bg thead-font wten">Time</th>
						<th class="common-bg thead-font wten">UpdateTime</th>
						<th class="common-bg thead-font wfive">IP</th>
						<th class="common-bg thead-font wfive">Comment</th>
						<th class="common-bg thead-font wtwo">Open</th>
						<th class="common-bg thead-font wtwo">Delete</th>
					</tr>
				</thead>
				<tbody class="executeOrder">
					@foreach (var item in Model)
					{
						<tr>
							<td class="wtwo"><div class="content"><p>@item.dealNo</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.loginId</p></div></td>
							<td class="wfive"><div class="content"><p>@item.name/@item.firm</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.mobile</p></div></td>
							<td class="wfive"><div class="content"><p>@item.symbolName</p></div></td>
							<td class="wone"><div class="content"><p>@(item.rateType == "mcx" ? "exchange" : item.rateType)</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.tradeTypeView</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.volumeOpen</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.volume</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.rateOpen</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.rate</p></div></td>
							<td class="wfive"><div class="content"><p>@item.total</p></div></td>
							<td class="wtwo"><div class="content"><p>@item.deviceType</p></div></td>
							<td class="wten"><div class="content"><p>@item.closeTime</p></div></td>
							<td class="wten"><div class="content"><p>@item.orderTime</p></div></td>
							<td class="wten"><div class="content"><p>@item.editorderTime</p></div></td>
							<td class="wfive"><div class="content"><p>@item.ip</p></div></td>
							<td class="wfive"><div class="content"><p>@item.comment</p></div></td>
							<td class="wtwo"><div class="content"><form asp-action="Open" asp-route-id="@item.id" asp-route-tradeFilter="@Context.Request.Query["tradeFilter"]" asp-route-sourceFilter="@Context.Request.Query["sourceFilter"]"><button onclick="return confirmDelete('open')"><i class="fa fa-external-link text-success" aria-hidden="true"></i></button></form></div></td>
							<td class="wtwo"><div class="content"><form asp-action="Delete" asp-route-id="@item.id" asp-route-tradeFilter="@Context.Request.Query["tradeFilter"]" asp-route-sourceFilter="@Context.Request.Query["sourceFilter"]"><button onclick="return confirmDelete()"><i class="fa fa-trash-o text-danger" aria-hidden="true"></i></button></form></div></td>

						</tr>
					}

					<tr class="summary-row bg-light font-weight-bold">
						<td colspan="8"></td>
						<td class="wtwo text-center">@ViewBag.CloseOrderTotalQuantity</td>
						<td colspan="2"></td>
						<td class="wtwo text-center">@String.Format("{0:0.##}", ViewBag.CloseOrderAveragePrice)</td>
						<td colspan="9"></td>
					</tr>
				</tbody>
			</table>
		</div>

	</div>
</div>
<script src="~/adminjs/order.js"></script>
