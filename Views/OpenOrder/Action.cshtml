@model OpenOrder
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="modal" style="padding-right: 17px;">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header common-bg rounded-0">
                <h5 class="modal-title h4 color-white md-font">Close Order</h5>
                <button type="button" class="close color-white" data-dismiss="modal" aria-label="Close">
                    <span class="color-white" aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form asp-action="closeOrder" method="post">
                    <input type="hidden" name="tradeFilter" id="tradeFilter" value="" />
                    <table>
                        <tbody>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">OrderNo</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input readonly asp-for="dealNo" type="text" class="input-height sm-font"></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">LoginID</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input readonly asp-for="loginId" type="text" class="input-height sm-font"></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">SymbolName</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input readonly asp-for="symbolName" type="text" class="input-height sm-font"></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">Volume</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><label>@Model.volume</label></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">CloseVolume</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input asp-for="volume" type="text" class="input-height sm-font"></td>
                            </tr>
                            
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">OpenPrice</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><label>@Model.rate</label></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">ClosePrice</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input asp-for="rate" type="text" class="input-height sm-font"></td>
                            </tr>
                            <tr>
                                <td class="sym-mod-lef text-left pb-2 pr-3"> <label for="" class="sm-font mb-0">Comment</label><span class="pl-rgt pr-2" style="float: right;">:</span></td>
                                <td class="sym-mod-right pb-2"><input asp-for="comment" type="text" class="input-height sm-font"></td>
                            </tr>
                            

                        </tbody>
                    </table>
                    <div class="btn-sub text-center">
                        <button class="btn common-bg sm-font">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        const params = new URLSearchParams(window.location.search);
        const tradeFilter = params.get('tradeFilter') || 'all';
        const hidden = document.getElementById('tradeFilter');
        if (hidden) {
            hidden.value = tradeFilter;
        }
    })();
</script>
