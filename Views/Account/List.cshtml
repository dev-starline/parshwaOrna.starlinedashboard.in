@using SL_Bullion.Constant
@model PaginationViewModel<SL_Bullion.Models.Account>

@{
    ViewData["Title"] = "Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.Search as string ?? "";
}
<div class="tab-bottom-cvr w-100 d-inline-block py-1">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="top-cover">
                    <button class="btn common-bg color-white sm-font addModel">New Account</button>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="top-cover text-center">
                    <h4 class="pt-1">Approved</h4>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="top-cover">
                    <form class="form-inline my-2 my-lg-0 justify-content-end account-form" method="get" asp-action="List">
                        <button formaction="@Url.Action("exportToExcel")" class="btn common-bg color-white my-2 mx-2 my-sm-0 sm-font" type="submit">Export to Excel</button>
                        <input name="search" value="@currentSearch" class="form-control accout-inpur-search" type="search" placeholder="LoginId / Name / FirmName / Mobile / City / Group" aria-label="Search">
                        <button formaction="@Url.Action("search")" class="btn common-bg color-white my-2 mx-2 my-sm-0 sm-font" type="submit">Search</button>
                        <a class="btn common-bg color-white my-2 my-sm-0 sm-font" href="@Url.Action("List")">All</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="table-cover">
    <div class="container-fluid">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th class="common-bg wone">isActive</th>
                        <th class="common-bg wthree">LoginId</th>
                        <th class="common-bg wfive">Name</th>
                        <th class="common-bg wfive">FirmName</th>
                        <th class="common-bg wthree">Mobile</th>
                        <th class="common-bg wthree">City</th>
                        <th class="common-bg wthree">TradeAccess</th>
                        <th class="common-bg wthree">Group</th>                         
                        <th class="common-bg wone">Edit</th>
                        <th class="common-bg wone">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="content">
                                    <p>@Html.DisplayFor(modelItem => item.isActive)</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.loginId</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.name</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.firmName</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.mobile</p>
                                </div>
                            </td>

                            <td>
                                <div class="content">
                                    <p>@item.city</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.tradeAccessView</p>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <p>@item.groupName</p>
                                </div>
                            </td>                         

                            <td>
                                <div class="content">
                                    <button class="ajax-model" data-url="@Url.Action($"Edit/{item.id}")">
                                        <i class="fa fa-pencil-square-o text-primary" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <form asp-action="Delete" asp-route-id="@item.id">
                                        <button onclick="return confirmDelete()">
                                            <i class="fa fa-trash-o text-danger" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="pagination text-center mt-3" style="float: right; margin-right: 20px;">
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-end">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link common-bg" asp-action="List" asp-route-page="@(currentPage > 1 ? currentPage - 1 : 1)" asp-route-search="@currentSearch">
                        <i class="fa fa-angle-double-left"></i> Previous
                    </a>
                </li>
                <li class="page-item">
                    <span class="page-link"> @currentPage / @totalPages</span>
                </li>
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link common-bg" asp-action="List" asp-route-page="@(currentPage < totalPages ? currentPage + 1 : totalPages)" asp-route-search="@currentSearch">
                        Next <i class="fa fa-angle-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>



@await Html.PartialAsync("Action", new Account())
<script src="~/adminjs/account.js"></script>
