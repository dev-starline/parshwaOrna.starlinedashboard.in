<div class="container-fluid">
    <div class="table-cover">
        <div class="row ml-0 mr-0">
            <div class="col-lg-4 col-md-0 col-sm-12"></div>
            <div class="col-lg-4 col-md-6 col-sm-12">
                <h4 class="text-center mt-1 mb-2">SymbolWise Summary Order</h4>
            </div>
        </div>
        <div class="table-wrapper oncover">
            <table>
                <thead>
                    <tr>

                        <th class="common-bg thead-font ab">Symbol</th>
                        <th class="common-bg thead-font ab">Buy Order Count</th>
                        <th class="common-bg thead-font ab">Buy Grams/Kg</th>
                        <th class="common-bg thead-font ab">Buy Average</th>
                        <th class="common-bg thead-font ab">Sell Order Count</th>
                        <th class="common-bg thead-font ab">Sell Grams/Kg</th>
                        <th class="common-bg thead-font ab">Sell Average</th>
                        <th class="common-bg thead-font ab">Net Grams/Kg</th>
                    </tr>
                </thead>
                <tbody class="executeOrder ovrcover">
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="ab"><div class="content"><p>@item.SymbolName</p></div></td>
                            <td class="ab"><div class="content"><p>@item.BuyCount</p></div></td>
                            <td class="ab"><div class="content"><p>@item.BuyVolume</p></div></td>
                            <td class="ab"><div class="content"><p>@item.BuyAvg.ToString("F2")</p></div></td>
                            <td class="ab"><div class="content"><p>@item.SellCount</p></div></td>
                            <td class="ab"><div class="content"><p>@item.SellVolume</p></div></td>
                            <td class="ab"><div class="content"><p>@item.SellAvg.ToString("F2")</p></div></td>
                            <td class="ab"><div class="content"><p>@item.NetGrams.ToString("F2")</p></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
