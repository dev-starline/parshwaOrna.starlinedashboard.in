@using SL_Bullion.Constant
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="tab-bottom-cvr w-100 d-inline-block py-1">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-4 col-md-12 col-sm-12"></div>
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="top-cover text-center">
                    <h4 class="pt-1">Register</h4>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12">
                <div class="top-cover">
                    <form class="form-inline my-2 my-lg-0 justify-content-end account-form">
                        <button class="btn common-bg color-white my-2 mx-2 my-sm-0 sm-font">Export to Excel</button>
                        <input class="form-control accout-inpur-search" type="search" placeholder="Search" aria-label="Search">
                        <button class="btn common-bg color-white my-2 mx-2 my-sm-0 sm-font" type="submit">Search</button>
                        <button class="btn common-bg color-white my-2 my-sm-0 sm-font">All</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="table-cover">
    <div class="container-fluid">
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th class="common-bg wfive">Name</th>
                        <th class="common-bg wfive">FirmName</th>
                        <th class="common-bg wthree">Mobile</th>
                        <th class="common-bg wthree">City</th>
                        <th class="common-bg wthree">DateTime</th>
                        <th class="common-bg wone">Approve</th>
                        <th class="common-bg wone">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><div class="content"><p>@item.name</p></div></td>
                            <td><div class="content"><p>@item.firmName</p></div></td>
                            <td><div class="content"><p>@item.mobile</p></div></td>
                            <td><div class="content"><p>@item.city</p></div></td>
                            <td><div class="content"><p>@item.modifiedDate.ToString("yyyy-MM-dd HH:mm:ss")</p></div></td>
                            <td>
                                <div class="content">
                                    <form asp-action="Approve" asp-route-id="@item.id">
                                        <button onclick="return confirmApprove()">
                                            <i class="fa fa-thumbs-up text-primary" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <div class="content">
                                    <form asp-action="Delete" asp-route-id="@item.id">
                                        <button onclick="return confirmDelete()">
                                            <i class="fa fa-trash-o text-danger" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- New Pagination -->
        <div class="pagination text-center mt-3" style="float: right; margin-right: 20px;">
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="List" asp-route-page="@(currentPage - 1)">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @currentPage of @totalPages</span>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="List" asp-route-page="@(currentPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<script src="~/adminjs/account.js"></script>
