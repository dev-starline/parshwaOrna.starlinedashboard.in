@model IEnumerable<SL_Bullion.Models.OrderFailureLogViewModel>
@{
    ViewData["Title"] = "Order Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="table-cover">
    <div class="container-fluid">
        <div class="table-wrapper">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="top-cover">
                    <div class="form-inline my-2 my-lg-0 justify-content-end">

                        <button onclick="selectOrder('delete')" class="btn common-bg color-white sm-font my-2">DeleteAll</button>
                    </div>
                </div>
            </div>
            <table>
                <thead>
                    <tr>
                        <th class="common-bg thead-font wone">
                            <input type="checkbox" id="selectAll" onclick="toggleAll(this)" />
                        </th>
                        <th class="common-bg thead-font ab">Date</th>
                        <th class="common-bg thead-font ab">Client Name</th>
                        <th class="common-bg thead-font ab">Firm/LoginId</th>
                        <th class="common-bg thead-font ab">Mobile</th>
                        <th class="common-bg thead-font ab">Symbol</th>
                        <th class="common-bg thead-font ab">Quantity</th>
                        <th class="common-bg thead-font ab">Price</th>
                        <th class="common-bg thead-font ab">Reason</th>
                        <th class="common-bg thead-font ab">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="wone">
                                <div class="content"><input name="selectedItems" id="@item.id" type="checkbox" /></div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>
                                        @item.createdAt.ToLocalTime().ToString("dd-MM-yyyy HH:mm")
                                    </p>
                                </div>
                            </td>

                            <td class="ab">
                                <div class="content">
                                    <p>@item.name</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.firmName/@item.loginId</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.mobileNumber</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.symbolName?</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.quantity</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.price</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <p>@item.reason</p>
                                </div>
                            </td>
                            <td class="ab">
                                <div class="content">
                                    <form asp-action="Delete" asp-route-id="@item.id">
                                        <button onclick="return confirmDelete()">
                                            <i class="fa fa-trash-o text-danger" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="pagination text-center mt-3" style="float: right; margin-right: 20px;">
        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-end">
                    <li class="page-item @(currentPage == 1 ? " disabled" : "" )">
                        <a class="page-link common-bg" asp-action="List" asp-route-page="@(currentPage > 1 ? currentPage - 1 : 1)">
                            <i class="fa fa-angle-double-left"></i> Previous
                        </a>
                    </li>
                    <li class="page-item">
                        <span class="page-link"> @currentPage / @totalPages</span>
                    </li>
                    <li class="page-item @(currentPage == totalPages ? " disabled" : "" )">
                        <a class="page-link common-bg" asp-action="List"
                           asp-route-page="@(currentPage < totalPages ? currentPage + 1 : totalPages)">
                            Next <i class="fa fa-angle-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>

    <script>

            function toggleAll(source) {
                const checkboxes = document.querySelectorAll('input[name="selectedItems"]');

                checkboxes.forEach(function(checkbox) {
                    checkbox.checked = source.checked;
                });
            }
            function selectOrder(type) {
                if (!confirm(`Are you sure you want to ${type} selected records?`)) return;
                debugger;
                const array = [];
                document.querySelectorAll('input[name="selectedItems"]:checked').forEach(item => {
                    array.push({
                        id: item.id,
                        type: type
                    });
                });

                if (array.length === 0) {
                    alert("Please select at least one row.");
                    return;
                }

                fetch('/admin/OrderLog/selectedItems', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(array)
                })
                    .then(response => {
                        if (response.ok) location.reload();
                        else throw new Error("Server error.");
                    })
                    .catch(error => alert("Failed: " + error));
            }

    </script>