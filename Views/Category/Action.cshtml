@model Category
<div class="container mt-5">
	<div class="modal fade" id="categoryCreate" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header common-bg rounded-0">
					<h5 class="modal-title h4 color-white md-font" id="symboladdmodal">Add Category</h5>
					<button type="button" class="close color-white" data-dismiss="modal" aria-label="Close">
						<span class="color-white" aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form asp-action="Create" method="post" onsubmit="return validateCategoryName(this)">
						<div class="form-group row">
							<div class="col-8">
								@* <input asp-for="Name" id="categoryName" type="text" class="form-control sm-font" /> *@
								<input id="categoryName" name="Name" type="text" class="form-control sm-font" oninput="hideNameError()" />
								<small id="nameErrorMsg" class="text-danger" style="display: none;">Please enter CategoryName.</small>
							</div>
							<div class="col-4">
								<button type="submit" class="btn common-bg w-100">Save</button>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>